nt="La2-pp"><mxGeometry x="45" y="590" width="230" height="80" as="geometry"/></mxCell><mxCell id="a2-jl" value="Job log&lt;br&gt;(Excel)" style="shape=mxgraph.flowchart.multi-document;whiteSpace=wrap;html=1;fontSize=11;strokeWidth=1.5;fillColor=#ffffff;align=left;spacingLeft=34;" vertex="1" parent="La2-pp"><mxGeometry x="275" y="599" width="135" height="62" as="geometry"/></mxCell><mxCell id="a2-jl-ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="a2-jl"><mxGeometry x="6" y="14" width="26" height="26" as="geometry"/></mxCell><mxCell id="a2-rv" value="&lt;b style=&quot;color: rgb(255, 0, 0);&quot;&gt;Reviewer&lt;/b&gt; reviews the working papers and raises review points in the audit software" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;strokeWidth=2;" vertex="1" parent="La2-rv"><mxGeometry x="45" y="720" width="230" height="80" as="geometry"/></mxCell><mxCell id="a2-open" value="Review points open?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;strokeWidth=2;" vertex="1" parent="La2-rv"><mxGeometry x="55" y="840" width="210" height="100" as="geometry"/></mxCell><mxCell id="a2-clear" value="&lt;b style=&quot;color: rgb(255, 0, 0);&quot;&gt;Preparer&lt;/b&gt; clears the review points" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;strokeWidth=2;" vertex="1" parent="La2-pp"><mxGeometry x="45" y="850" width="230" height="80" as="geometry"/></mxCell><mxCell id="a2-draft" value="&lt;b style=&quot;color: rgb(255, 0, 0);&quot;&gt;Reviewer&lt;/b&gt; emails the draft report to the client" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;strokeWidth=2;" vertex="1" parent="La2-rv"><mxGeometry x="45" y="980" width="230" height="80" as="geometry"/></mxCell><mxCell id="a2-ok" value="Client approves the draft report?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;strokeWidth=2;" vertex="1" parent="La2-cl"><mxGeometry x="55" y="1120" width="210" height="100" as="geometry"/></mxCell><mxCell id="a2-