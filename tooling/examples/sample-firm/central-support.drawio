-rc"><mxGeometry x="275" y="339" width="135" height="62" as="geometry"/></mxCell><mxCell id="cA-dl-ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="cA-dl"><mxGeometry x="6" y="14" width="26" height="26" as="geometry"/></mxCell><mxCell id="cA-book" value="&lt;b style=&quot;color: rgb(255, 0, 0);&quot;&gt;Attestation PIC&lt;/b&gt; books the Commissioner for Oaths in the Microsoft Teams attestation chat&lt;br&gt;&lt;i style=&quot;color: rgb(128, 128, 128);&quot;&gt;Time: Within 2 working days&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;strokeWidth=2;" vertex="1" parent="LcA-at"><mxGeometry x="45" y="460" width="230" height="80" as="geometry"/></mxCell><mxCell id="cA-tm" value="Microsoft Teams" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;fontSize=11;image=data:image/png,;" vertex="1" parent="LcA-at"><mxGeometry x="320" y="477" width="46" height="46" as="geometry"/></mxCell><mxCell id="cA-att" value="&lt;b style=&quot;color: rgb(255, 0, 0);&quot;&gt;Commissioner for Oaths&lt;/b&gt; attests the signing pages" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;strokeWidth=2;" vertex="1" parent="LcA-co"><mxGeometry x="45" y="610" width="230" height="80" as="geometry"/></mxCell><mxCell id="cA-log" value="&lt;b style=&quot;color: rgb(255, 0, 0);&quot;&gt;Attestation PIC&lt;/b&gt; records the attestation date in the central support job log" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;strokeWidth=2;" vertex="1" parent="LcA-at"><mxGeometry x="45" y="720" width="230" height="80" as="geometry"/></mxCell><mxCell id="cA-cl" value="Central support job log&lt;br&gt;(Excel)" style="shape=mxgraph.flowchart.multi-document;whiteSpace=wrap;html=1;fontSize=11;strokeWidth=1.5;fillColor=#ffffff;align=left;spacingLeft=34;" vertex="1" parent="LcA-at"><mxGeometry x="275" y="729" width="135" height="62" as="geometry"/></mxCell><mxCell id="cA-cl-ic" va